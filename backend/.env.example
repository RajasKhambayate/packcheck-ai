# Copy this file to .env and adjust as needed.

APP_NAME=PackCheck AI
ENV=development

# Default: local SQLite file (zero setup). For production, use Postgres:
# DATABASE_URL=postgresql+psycopg2://packcheck:packcheck@db:5432/packcheck
DATABASE_URL=sqlite:///./packcheck.db

SECRET_KEY=replace-with-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=*
